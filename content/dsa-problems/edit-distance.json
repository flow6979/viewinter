"zvrijxyjdczhypsdrecmlwjpouccelkeazcbznzulhbqdtixojxuybvawasejkxghtusrhbsgookrynpdtmhfbmfwtmwnenfuartwjldktvgzfysezqbntytrokghxffbqkuahtggykyuqcmzbrnadnegbeorfgllphkbxxyypfbsmjpmxehgrmnwspkdnmkpdptkwihbqkpchrsiyvohjdutugiibkwodrifhzarpstbsdbzgegfriyjcwrdxcwvgeuzysdnylrmmbxnywwawvm",""],"expected":265},{"args":["abaabaa","a"],"expected":6},{"args":["",""],"expected":8},{"args":["bbabbaacababaacacbbcbaacabccbbacaccbbacaccbaabbaccbbacbbcabcbcccabcbcaaacbbbcbcccbaacccbccabccbbacbcbbbaacbcbbbbaacccabcabbaabcbacaccbaccbbbacbccbabaccbaacaaaccccacabbccbccccabccaacabaabbccccaabcabbacbccbbbbacacaccbccbcbbaaaacaacbccbacbbc","bbabbaacababaacacbbcbaacabccbbacaccbbacaccbaabbaccbbacbbcabcbcccabcbcaaacbbbcbcccbaacccbccabccbbacbcbbbaacbcbbbbaacccabcabbaabcbacaccbaccbbbacbccbabaccbaacaaaccccacabbccbccccabccaacabaabbccccaabcabbacbccbbbbaacaccbccbcbbaaaacaacbccbacbbc"],"expected":1},{"args":["asfovlj","ancvlwo"],"expected":5},{"args":["",""],"expected":9},{"args":["sfsoladgxginfqqewiulpyrefkzmrjrocnsilyyzowustlwlriqdtviqlyqasqcxzwntndrdlrzwvpgmjhxnmdjwcyuaeqefcrwgfvptpvkxoqwngvxilryrlbnhvnsbugokmyqrrvghzrgakpyjmulgjt","sfsoladgxginfqqewiulpyrefkzmrjrocnsilyyzowustyalriqdtviwlyqbsqcxzwntndrdlrzwpgmjhxnmdjwcuaeqefcrwgfvptpvkxoqwngvxilryrlbnhgnsbugokmyqrrvghzrgakpyjmulgjt"],"expected":7},{"args":["","vtgm"],"expected":4},{"args":["",""],"expected":4},{"args":["",""],"expected":8},{"args":["cbba","ca"],"expected":2},{"args":["",""],"expected":5}],"solution":{"approach":{"hi":"Classic Levenshtein DP. Base: dp[i][0] = i (sab delete), dp[0][j] = j (sab insert). Chars equal ho to diagonal copy, warna 1 + teen neighbours ka min. Ek row rakhna kaafi hai. O(m·n) time, O(n) space.","en":"Classic Levenshtein DP. Base: dp[i][0] = i (delete all), dp[0][j] = j (insert all). Equal chars copy the diagonal, otherwise 1 + the min of the three neighbours. One row is enough. O(m·n) time, O(n) space."},"cpp":"class Solution {\npublic:\n    int minDistance(string& word1, string& word2) {\n        int n = word1.size(), m = word2.size();\n        vector<int> prev(m + 1), cur(m + 1);\n        for (int j = 0; j <= m; j++) prev[j] = j;\n        for (int i = 1; i <= n; i++) {\n            cur[0] = i;\n            for (int j = 1; j <= m; j++)\n                cur[j] = word1[i - 1] == word2[j - 1] ? prev[j - 1]\n                                                     : 1 + min({prev[j - 1], prev[j], cur[j - 1]});\n            swap(prev, cur);\n        }\n        return prev[m];\n    }\n};"}}