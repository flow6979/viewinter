cababcaccc"]],"expected":true},{"args":["abbaaaaabbaaaaabbbababaabaabababbb",["bbba","aaabbaaaaa","baa","bba","bbbababaabaabababbb","a"]],"expected":true},{"args":["ccccccccc",["c"]],"expected":true},{"args":["abbbacbcbabcbcabacacbbcbcabacacbbaczcabacacbbaaacabbabacaabaacacaacbc",["bab","cacbacabcacacb","abbbcabaaccbc","cbcabacacbb","acacaacbc","caacbcccb","ac","aca","bb","abbbacbc","cc","ab","aba","a","aaaca","bbb","bcba","baaaccbacaca","caaba","bacbaacba","ccbabbbaca"]],"expected":false},{"args":["gfidgagejfjdddbhfjede",["gg","fifcbgecjhj","hedbdbhjcfhdeeg","e","bc","h","igaa","ie","gfidgagejfjdd","hfjede","f","j","iaj","ffgibgagjfbedejcjfcc","jedehg","b","bd","cbi","be","fciififhfddjf","eifd","dd","d","c"]],"expected":true},{"args":["aababbaababbaababbbb",["aab","bb","abb","ab","ababaabbbbbabbbbbabb","bbabaaabaaabbbaaaaaa"]],"expected":true},{"args":["dd",["gf","d","cbgiaacafeaijabgjih","egjcdiiiighhhc"]],"expected":true},{"args":["baaacbaacbcabcaacabaabbcaccababbbbaa",["baabbbacaabcacbcbb","bbcc","c","abccacacaab","acc","acca","caaaabbababbb","bccaccacbabbbc","bcabc","baa","acb","abbcb","cbb","ababbbbaa","aacabaabbcabc","bacbbccbb","cbaabbbacbabcbcbcbc","a","baabbc","aacca","babbacbcbcac","cacac","ccccbbbccbabaccaacaa","bb","bcacacaabca","b","acbaa"]],"expected":true},{"args":["bhgbbbgbgg",["g","b"]],"expected":false},{"args":["eebiebfbhcfhhahidhgjjibghcjjee",["ee","jeiichddeabbjijihji","acicccbhaa","hbbjcaahgifab","eggcfjif","eaj","jj","bfbhcfhha","igabecfcfgcegigch","eea","jbbhcjijgaifbhh","h","ajhdi","bie","b","ijgebdhhgcaiaf","ffjhg","ge","achgbfjgdchae","fjcjaggjgfejicaafb","ibhie","cdbbhchhfgdjigg","jdcaaf","aadef","achehebhffbja","idhgjjbbghc","cfhgjc","ajc","dijahf","hia"]],"expected":false},{"args":["accbacbcbdaab",["dabdaccabb","abd","bcaabc","bcada","bba","cbcbbaab","accba","abcd","dbccddccbbaaadbbdbc","cada","bd","bcb"]],"expected":false},{"args":["baaccbbacbbbbbzaabba",["bcab","baa","ccbbacbbbbb","aaabba"]],"expected":false},{"args":["bbaabbbaaab",["ab","bbaa","aabbbaabbaaaaabaaa","aabbbba","bbaaab","aaaabbaaa","ba","a","aabbba","abb","bbab","bbbaabbbbababb","abbaabbaba","bbaabaaab","b","aa","bba","abbaab","abbbba","bbabaababbbbabbaaa","aabaaaabaab","bbaab","babbabbbbaababb","bababbbaaaab","abaaab","aba","bbba","baaabaaa","abba","baa","bbb"]],"expected":true},{"args":["cbacacbbcabcbb",["a","bcbabbaccbcbbb","bc","ccacbbacbacb","bbcbcbccccbcbcaabc","aac","cccaaaccabacbaaaaa","ccacaaaa","bbcca","abbbccaabcababbbaa","bcacb","baa","bbbcbbacc","c","caabca","bcb","cbacacbbcabcbb","abcbcc","ac","aacb","bbb","bbacaaaacbbbccaa","abbabcaab","b","aacaa","bacccaabbcabaacac","bbcccbabcbc","ccb","ca","acc","babacb"]],"expected":true},{"args":["aabaaba",["aab","a","baabbbaabaaaaabbaaab","abaabaabaa","aaab"]],"expected":true},{"args":["abdaadbadbaacacaaabdcbbaaabadabcdbdaaaccdabbacdaccccbabccbdccabddaadbadbaacacaaabdcbabdd",["a","dabd","ab","daadbadbaacacaaabdcb","bdcbdabacdbaababcc","bbcbbcda","b","adda","da","abdd","aacbaacdabbdabad","baaabadabcdbdaa","cccd","dddaa","daacddacdabccdcbbcd","accdabbacdaccccbabc","bcb","bca","cdddcc","abd","cbdcc","bbaabbccabadaabcbb","cdcbadaadaaacdabba","dd","bdd","dacdcbbcbddbccdacb","d","cbcab","daaad","db","ada","dcddbdaddbbcdcdad","dac"]],"expected":true},{"args":["abbbbabbbbaabbabbbaaaaabbabbbaaaabbbaaaaabbabbbaaaa",["bb","baabaababbbbbbb","bba","aa","aab","bbbaaaaabbabbbaaaa","aaab","a","bbbb"]],"expected":true},{"args":["badabbdbcdacdadccabc",["adc","cabc","badabbdbcdacd","cbcddb","bbbbbd"]],"expected":true},{"args":["aaabacabcbacabcabbacaaabaaaaacbb",["bac","b","cc","babaaaccaccbcbcaa","acbb","cab","bbbcaaabccacab","cbbcbccaccccbcacaaa","ac","aaabacabcba","ba","caa","ca","baaaccbcbcaabccccb","cbbbaacccb","aac","cacbacccaba","aaa","bb","bbbac","bcaca","accb","c","bab"]],"expected":true}],"solution":{"approach":{"hi":"DP on prefixes: `ok[0] = true`. Har `i` ke liye pichhle positions `j` dekho (max 20 peeche, kyunki word length ≤ 20): agar `ok[j]` aur `s.substr(j, i-j)` set me hai to `ok[i] = true`. O(n · L · L) time with hash set, O(n) space.","en":"DP over prefixes: `ok[0] = true`. For each `i`, look back at positions `j` (at most 20 back, since words are ≤ 20 long): if `ok[j]` and `s.substr(j, i-j)` is in the set, `ok[i] = true`. O(n · L · L) time with a hash set, O(n) space."},"cpp":"class Solution {\npublic:\n    bool wordBreak(string& s, vector<string>& wordDict) {\n        unordered_set<string> dict(wordDict.begin(), wordDict.end());\n        int n = s.size();\n        vector<bool> ok(n + 1, false);\n        ok[0] = true;\n        for (int i = 1; i <= n; i++)\n            for (int j = max(0, i - 20); j < i && !ok[i]; j++)\n                if (ok[j] && dict.count(s.substr(j, i - j))) ok[i] = true;\n        return ok[n];\n    }\n};"}}