      vector<int> last(256, -1);\n        int l = 0, best = 0;\n        for (int r = 0; r < (int)s.size(); r++) {\n            unsigned char c = s[r];\n            if (last[c] >= l) l = last[c] + 1;\n            last[c] = r;\n            best = max(best, r - l + 1);\n        }\n        return best;\n    }\n};"}}