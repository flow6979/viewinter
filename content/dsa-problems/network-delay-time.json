             if (d + w < dist[v]) {\n                    dist[v] = d + w;\n                    pq.push({dist[v], v});\n                }\n        }\n        int ans = 0;\n        for (int i = 1; i <= n; i++) {\n            if (dist[i] == INF) return -1;\n            ans = max(ans, dist[i]);\n        }\n        return ans;\n    }\n};"}}