rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Site owner: whoever has a doc at admins/{uid} (created by hand in the console) may read accounts
    // and traffic for the Stats page. Nobody can write admins/ from the app.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isCount(field) {
      return request.resource.data.get(field, 0) is int;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // Anonymous daily visit counter (traffic.ts): anyone can add to today's counts, only the owner reads
    match /traffic/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visitors', 'newVisitors', 'sessions', 'views', 'mobile', 'desktop', 'pages'])
        && isCount('visitors') && isCount('newVisitors') && isCount('sessions') && isCount('views') && isCount('mobile') && isCount('desktop')
        && request.resource.data.get('pages', {}) is map && request.resource.data.get('pages', {}).size() < 1000;
      allow delete: if false;
    }
    // Shared topic lists (/list/{id}): public ones open for anyone with the link, private ones only
    // for their owner. Opened one by one by id; nobody can browse or search the collection.
    match /sharedLists/{id} {
      function validList() {
        let d = request.resource.data;
        return isOwner(d.by)
          && d.keys().hasOnly(['by', 'byName', 'name', 'slugs', 'questions', 'public', 'at'])
          && d.name is string && d.name.size() <= 120
          && d.byName is string && d.byName.size() <= 120
          && d.slugs is list && d.slugs.size() <= 500
          && d.questions is list && d.questions.size() <= 300
          && d.public is bool;
      }
      allow get: if resource.data.public == true || isOwner(resource.data.by);
      allow list: if false;
      allow create: if validList();
      allow update: if isOwner(resource.data.by) && validList();
      allow delete: if isOwner(resource.data.by);
    }
    // Mock interview count on the Stats page
    match /{path=**}/interviews/{id} {
      allow read: if isAdmin();
    }
    // Shared quiz bank: questions Gemini generated once, reused by everyone.
    // Anyone can read; logged-in users can add well-formed questions; nobody can edit or delete.
    match /quiz/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.v == 1
        && request.resource.data.section in ['hld', 'lld', 'java', 'db', 'cs', 'rag', 'dsa', 'agents']
        && request.resource.data.topic is string && request.resource.data.topic.size() < 80
        && request.resource.data.answer is int && request.resource.data.answer >= 0 && request.resource.data.answer <= 3
        && request.resource.data.options.hi.size() == 4 && request.resource.data.options.en.size() == 4
        && request.resource.data.q.hi is string && request.resource.data.q.hi.size() < 2000
        && request.resource.data.q.en is string && request.resource.data.q.en.size() < 2000
        && request.resource.data.keys().hasOnly(['v', 'section', 'topic', 'level', 'q', 'options', 'answer', 'why', 'by', 'at']);
      allow update, delete: if false;
    }

    // AI-generated practice problems, verified in the browser against the compiler before saving.
    // Anyone can read; logged-in users can add new ones; nobody can overwrite or delete.
    match /dsaIndex/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() < 200
        && request.resource.data.difficulty in ['easy', 'medium', 'hard']
        && request.resource.data.keys().hasOnly(['id', 'title', 'topic', 'difficulty', 'points', 'lc', 'tags', 'order', 'ai', 'by', 'at']);
      allow update, delete: if false;
    }
    match /dsaProblems/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        // compressed `z` bytes (new) or a plain `data` string (old clients)
        && ((request.resource.data.get('z', null) is bytes && request.resource.data.z.size() < 900000)
          || (request.resource.data.get('data', null) is string && request.resource.data.data.size() < 900000))
        && request.resource.data.keys().hasOnly(['data', 'z', 'by', 'at']);
      allow update, delete: if false;
    }
    // Company interview questions found on the web, cached for everyone (refreshable)
    match /companyQuestions/{key} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && ((request.resource.data.get('z', null) is bytes && request.resource.data.z.size() < 600000)
          || (request.resource.data.get('data', null) is string && request.resource.data.data.size() < 600000))
        && request.resource.data.keys().hasOnly(['company', 'role', 'data', 'z', 'by', 'at']);
      allow delete: if false;
    }

    // Each user can read and write only their own progress, profile and notes
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
      // Gemini key synced across the user's devices; owner only (not even the admin)
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
      // Resume page: practice answers + AI feedback (the resume text itself stays in the browser)
      match /resume/{docId} {
        allow read, write: if isOwner(uid);
      }
      // Mock interviews: only the compact scorecard (no transcript, video or board)
      match /interviews/{id} {
        allow read, write: if isOwner(uid);
      }
      // Company prep: the user's own answers and AI answers per company + role
      match /companyPrep/{key} {
        allow read, write: if isOwner(uid);
      }
      match /notes/{slug} {
        allow read, delete: if isOwner(uid);
        // Notes are plain `text` (short) or deflate-compressed `z` bytes (long). Cap the size either way.
        allow create, update: if isOwner(uid) && (
          (request.resource.data.get('text', null) is string && request.resource.data.text.size() < 200000) ||
          (request.resource.data.get('z', null) is bytes && request.resource.data.z.size() < 200000)
        );
      }
    }
  }
}
